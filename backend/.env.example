# Text model: none (default, templates only) | ollama | cloud
# Planning never uses a model. It only words the optional "warmer words" text.
TEXT_MODEL=none

# Model config — used when TEXT_MODEL=ollama (or for uploads, if enabled)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
VISION_MODEL=llava:7b   # fallback for image parsing if LLM_MODEL has no vision

# Used when TEXT_MODEL=cloud: any OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Instagram / screenshot uploads (off by default)
ENABLE_UPLOADS=false

# Optional enrichment APIs
SERP_API_KEY=
OPENWEATHER_API_KEY=

# App
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173
